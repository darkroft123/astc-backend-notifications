# =============================================================================
# astc-cn-notification-email — Variables de Entorno
# =============================================================================

# --- Database (solo lectura, schema notification) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE_NAME=email.notification
RABBITMQ_QUEUE_NAME=email-notification.queue
RABBITMQ_ROUTING_KEY=email.notification
RABBITMQ_DLX_EXCHANGE=DLX

# --- Retry ---
EMAIL_NOTIFICATION_MAX_RETRIES=3
EMAIL_NOTIFICATION_DLQ_TTL_MS=60000

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SSL=false
SMTP_TLS=true
SMTP_MOCK=false

# --- Email Sender ---
EMAIL_SENDER=noreply@astc.com
EMAIL_SENDER_NAME=ASTC - Sistema de Asistencia

# --- Logging ---
LOG_LEVEL=INFO
